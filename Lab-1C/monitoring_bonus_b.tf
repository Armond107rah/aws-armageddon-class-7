# Detect server errors generated by the ALB
resource "aws_cloudwatch_metric_alarm" "alb_5xx" {
  alarm_name          = "lab1c-bonus-b-alb-5xx"
  alarm_description   = "ALB generated 5 or more 5XX errors in 5 minutes"
  comparison_operator = "GreaterThanOrEqualToThreshold"

  evaluation_periods = 1
  threshold          = 5

  namespace   = "AWS/ApplicationELB"
  metric_name = "HTTPCode_ELB_5XX_Count"

  period    = 300
  statistic = "Sum"

  dimensions = {
    LoadBalancer = module.load_balancer.alb_arn_suffix
  }

  treat_missing_data = "notBreaching"
}

# Detect server errors generated by the Flask application
resource "aws_cloudwatch_metric_alarm" "app_5xx" {
  alarm_name          = "lab1c-bonus-b-app-5xx"
  alarm_description   = "Application generated 5 or more 5XX errors in 5 minutes"
  comparison_operator = "GreaterThanOrEqualToThreshold"

  evaluation_periods = 1
  threshold          = 5

  namespace   = "AWS/ApplicationELB"
  metric_name = "HTTPCode_Target_5XX_Count"

  period    = 300
  statistic = "Sum"

  dimensions = {
    LoadBalancer = module.load_balancer.alb_arn_suffix
  }

  treat_missing_data = "notBreaching"
}