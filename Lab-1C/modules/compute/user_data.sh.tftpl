#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/lab1c-bootstrap.log) 2>&1

dnf install -y python3 python3-pip httpd amazon-cloudwatch-agent
id rdsapp >/dev/null 2>&1 || useradd --system --home-dir /opt/rdsapp --shell /sbin/nologin rdsapp
mkdir -p /opt/rdsapp
printf '%s' '${app_b64}' | base64 --decode > /opt/rdsapp/app.py
printf '%s' '${requirements_b64}' | base64 --decode > /opt/rdsapp/requirements.txt
python3 -m venv /opt/rdsapp/venv
/opt/rdsapp/venv/bin/pip install --no-cache-dir -r /opt/rdsapp/requirements.txt
chown -R rdsapp:rdsapp /opt/rdsapp

touch /var/log/rdsapp.log
chown rdsapp:rdsapp /var/log/rdsapp.log
chmod 640 /var/log/rdsapp.log

cat > /etc/systemd/system/rdsapp.service <<'SERVICE'
[Unit]
Description=Armageddon Flask notes application
After=network-online.target
Wants=network-online.target

[Service]
User=rdsapp
Group=rdsapp
WorkingDirectory=/opt/rdsapp
Environment=AWS_REGION=us-east-1
Environment=PARAMETER_PREFIX=/lab/db
Environment=DB_INSTANCE_IDENTIFIER=${project_name}-mysql
ExecStart=/opt/rdsapp/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8080 --access-logfile - --error-logfile - app:app
Restart=always
RestartSec=5
StandardOutput=append:/var/log/rdsapp.log
StandardError=append:/var/log/rdsapp.log

[Install]
WantedBy=multi-user.target
SERVICE

# Apache listens on port 80; Gunicorn is reachable only on localhost:8080.
cat > /etc/httpd/conf.d/rdsapp.conf <<'APACHE'
ProxyPreserveHost On
ProxyPass / http://127.0.0.1:8080/
ProxyPassReverse / http://127.0.0.1:8080/
APACHE

cat > /opt/aws/amazon-cloudwatch-agent/etc/lab1c-app-logs.json <<'AGENT'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/rdsapp.log",
            "log_group_name": "/aws/ec2/${project_name}-rds-app",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
AGENT

systemctl daemon-reload
systemctl enable --now rdsapp
systemctl enable --now httpd

# Log group may not exist until monitoring Terraform finishes; restart agent after apply if necessary.
if ! /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/lab1c-app-logs.json; then
    echo 'CloudWatch agent startup failed; inspect and retry after Terraform apply'
fi
