
#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/lab3-bootstrap.log) 2>&1

echo "Starting Tokyo private application bootstrap"

# Install OS packages through approved
# Amazon Linux repositories.
# Requires working regional S3 connectivity.

dnf install -y \
  python3 \
  python3-pip \
  amazon-cloudwatch-agent

# Prepare directories.

id rdsapp >/dev/null 2>&1 || \
  useradd --system \
  --home-dir /opt/rdsapp \
  --shell /sbin/nologin rdsapp

mkdir -p /opt/rdsapp /etc/pki/rds

# Download private application artifact.

aws s3 cp \
  "s3://${artifact_bucket}/${artifact_key}" \
  /tmp/tokyo-app-bundle.tar.gz \
  --region "${aws_region}" \
  --only-show-errors

# Reject any bundle that does not match
# the approved deployment checksum.

printf '%s  %s\n' \
  '${artifact_sha256}' \
  /tmp/tokyo-app-bundle.tar.gz \
  | sha256sum -c -

# Extract trusted application artifact.

tar -xzf /tmp/tokyo-app-bundle.tar.gz \
  -C /opt/rdsapp

# Install official RDS trust bundle.

install -m 0644 \
  /opt/rdsapp/certs/global-bundle.pem \
  /etc/pki/rds/global-bundle.pem

# Install application dependencies locally.
# Do not contact public PyPI from EC2.

python3 -m venv /opt/rdsapp/venv

/opt/rdsapp/venv/bin/pip install \
  --no-index \
  --find-links=/opt/rdsapp/wheels \
  -r /opt/rdsapp/requirements.txt

chown -R rdsapp:rdsapp /opt/rdsapp

# Prepare sanitized application logging.

touch /var/log/rdsapp.log
chown rdsapp:rdsapp /var/log/rdsapp.log
chmod 640 /var/log/rdsapp.log

# Configure the application as a service.

cat > /etc/systemd/system/rdsapp.service <<'SERVICE'
[Unit]
Description=Tokyo Flask Application
After=network-online.target
Wants=network-online.target

[Service]
User=rdsapp
Group=rdsapp
WorkingDirectory=/opt/rdsapp

Environment="AWS_REGION=${aws_region}"
Environment="PARAMETER_PREFIX=${parameter_prefix}"
Environment="DB_INSTANCE_IDENTIFIER=${db_instance_identifier}"
Environment="RDS_CA_BUNDLE=/etc/pki/rds/global-bundle.pem"

ExecStart=/opt/rdsapp/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8080 app:app

Restart=always
RestartSec=5

StandardOutput=append:/var/log/rdsapp.log
StandardError=append:/var/log/rdsapp.log

[Install]
WantedBy=multi-user.target
SERVICE

# Configure CloudWatch Agent log collection.

cat > /opt/aws/amazon-cloudwatch-agent/etc/tokyo-app.json <<'AGENT'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/rdsapp.log",
            "log_group_name": "${log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
AGENT

# Start the application.

systemctl daemon-reload
systemctl enable --now rdsapp

# Start CloudWatch log collection.

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/tokyo-app.json

rm -f /tmp/tokyo-app-bundle.tar.gz

echo "Tokyo application bootstrap completed"
