
#!/bin/bash

set -euo pipefail

# Bootstrap diagnostics. Never echo credentials.
exec > >(tee -a /var/log/lab3-bootstrap.log) 2>&1

echo "Starting Tokyo application bootstrap"

# Requires approved package repository access.
dnf install -y python3 python3-pip httpd

# Create a dedicated non-login application user.
id rdsapp >/dev/null 2>&1 || \
  useradd --system \
  --home-dir /opt/rdsapp \
  --shell /sbin/nologin rdsapp

mkdir -p /opt/rdsapp

# Install the existing Flask source code.
# This is source code, not credentials.
printf '%s' '${app_b64}' | base64 --decode \
  > /opt/rdsapp/app.py

printf '%s' '${requirements_b64}' | base64 --decode \
  > /opt/rdsapp/requirements.txt

# Install Python application dependencies.
# Requires approved outbound package access.
python3 -m venv /opt/rdsapp/venv

/opt/rdsapp/venv/bin/pip install \
  --no-cache-dir \
  -r /opt/rdsapp/requirements.txt

chown -R rdsapp:rdsapp /opt/rdsapp

# Create a systemd service for the application.
cat > /etc/systemd/system/rdsapp.service <<'SERVICE'
[Unit]
Description=Tokyo Flask Application
After=network-online.target
Wants=network-online.target

[Service]
User=rdsapp
Group=rdsapp
WorkingDirectory=/opt/rdsapp

Environment="AWS_REGION=${aws_region}"
Environment="PARAMETER_PREFIX=${parameter_prefix}"
Environment="DB_INSTANCE_IDENTIFIER=${db_instance_identifier}"

ExecStart=/opt/rdsapp/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8080 app:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE

# Apache acts as a local reverse proxy.
cat > /etc/httpd/conf.d/rdsapp.conf <<'APACHE'
ProxyPreserveHost On
ProxyPass / http://127.0.0.1:8080/
ProxyPassReverse / http://127.0.0.1:8080/
APACHE

# Restrict application file access.
chmod 644 /opt/rdsapp/app.py
chmod 644 /opt/rdsapp/requirements.txt

systemctl daemon-reload

systemctl enable --now rdsapp
systemctl enable --now httpd

echo "Tokyo application bootstrap completed"
